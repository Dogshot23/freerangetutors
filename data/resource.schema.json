{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freerangetutors.com/data/resource.schema.json",
  "title": "Free Range Tutors resource entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "url", "image", "description_short", "source_category", "creator",
    "resource_type", "primary_category", "age_group", "cefr_level", "prep_level",
    "cost", "date_added"
  ],
  "definitions": {
    "semanticSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "specific" },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true }
          },
          "required": ["mode", "values"]
        },
        {
          "properties": { "mode": { "enum": ["universal", "unknown", "not_applicable"] } }
        }
      ]
    }
  },
  "properties": {
    "id":                 { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name":                { "type": "string", "minLength": 1 },
    "url":                 { "type": "string", "minLength": 1 },
    "image":               { "type": "string", "minLength": 1 },
    "description_short":   { "type": "string", "minLength": 1 },
    "teacher_note":        { "type": ["string", "null"] },
    "source_category":     { "enum": ["own_original", "curated_external", "commercial"] },
    "creator":             { "type": "string", "minLength": 1 },
    "domain":              { "type": ["string", "null"] },
    "resource_type": {
      "enum": ["website", "app", "game", "pdf", "generator", "tool", "video", "activity"]
    },
    "primary_category": {
      "enum": ["teaching_materials", "web_apps_tools", "games", "websites_resource_hubs", "media"]
    },
    "primary_subtype": { "type": ["string", "null"] },

    "age_group": {
      "allOf": [{ "$ref": "#/definitions/semanticSet" }],
      "properties": {
        "mode": { "type": "string" },
        "values": { "items": { "enum": ["young_learner", "teen", "adult"] } }
      }
    },
    "cefr_level": {
      "allOf": [{ "$ref": "#/definitions/semanticSet" }],
      "properties": {
        "mode": { "type": "string" },
        "values": { "items": { "enum": ["A1", "A2", "B1", "B2", "C1"] } }
      }
    },
    "group_fit": {
      "allOf": [{ "$ref": "#/definitions/semanticSet" }],
      "properties": {
        "mode": { "type": "string" },
        "values": { "items": { "enum": ["individual", "pair", "group"] } }
      }
    },

    "teaching_use": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activity_time_minutes": { "type": ["number", "null"], "minimum": 0 },
    "duration_alt_minutes":  { "type": ["number", "null"], "minimum": 0 },
    "duration_alt_note":     { "type": ["string", "null"] },
    "prep_level":          { "enum": ["none", "light", "moderate", "varies"] },
    "setting":             { "enum": ["online", "classroom", "either"] },
    "cost":                { "enum": ["free", "freemium", "paid"] },

    "ai_powered": { "type": "boolean" },

    "gtmk_relationship":   { "type": ["string", "null"] },
    "status":              { "enum": ["live", "beta", "experimental", null] },
    "featured":            { "type": "boolean" },
    "date_added":          { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date_updated":        { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "internal_notes":      { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "source_category": { "const": "curated_external" } } },
      "then": { "required": ["domain"] }
    },
    {
      "if": { "properties": { "source_category": { "const": "commercial" } } },
      "then": { "required": ["domain"] }
    }
  ]
}

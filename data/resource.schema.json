{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freerangetutors.com/data/resource.schema.json",
  "title": "Free Range Tutors resource entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "url", "description_short", "source_category", "creator",
    "resource_type", "card_style", "age_group", "cefr_level", "prep_level",
    "cost", "pathways", "date_added"
  ],
  "properties": {
    "id":                 { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name":                { "type": "string", "minLength": 1 },
    "url":                 { "type": "string", "minLength": 1 },
    "image":               { "type": ["string", "null"] },
    "description_short":   { "type": "string", "minLength": 1 },
    "teacher_note":        { "type": ["string", "null"] },
    "source_category":     { "enum": ["own_original", "curated_external", "commercial"] },
    "creator":             { "type": "string", "minLength": 1 },
    "domain":              { "type": ["string", "null"] },
    "resource_type":       { "type": "string", "minLength": 1 },
    "card_style":          { "enum": ["activity", "collection"] },
    "age_group": {
      "type": "array",
      "items": { "enum": ["young_learner", "teen", "adult"] },
      "uniqueItems": true
    },
    "cefr_level": {
      "type": "array",
      "items": { "enum": ["A1", "A2", "B1", "B2", "C1"] },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activity_time_minutes": { "type": ["number", "null"], "minimum": 0 },
    "duration_alt_minutes":  { "type": ["number", "null"], "minimum": 0 },
    "duration_alt_note":     { "type": ["string", "null"] },
    "prep_level":          { "enum": ["none", "light", "moderate", "varies"] },
    "group_fit": {
      "type": "array",
      "items": { "enum": ["individual", "pair", "group"] },
      "uniqueItems": true
    },
    "setting":             { "enum": ["online", "classroom", "either"] },
    "cost":                { "enum": ["free", "freemium", "paid"] },
    "pathways": {
      "type": "array",
      "items": {
        "enum": ["talking", "play", "vocab", "grammar", "listen_watch", "emergency", "tools"]
      }
    },
    "gtmk_relationship":   { "type": ["string", "null"] },
    "status":              { "enum": ["live", "beta", "experimental", null] },
    "featured":            { "type": "boolean" },
    "date_added":          { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date_updated":        { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "internal_notes":      { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "source_category": { "const": "curated_external" } } },
      "then": { "required": ["domain"] }
    },
    {
      "if": { "properties": { "source_category": { "const": "commercial" } } },
      "then": { "required": ["domain"] }
    },
    {
      "if": { "properties": { "card_style": { "const": "activity" } } },
      "then": {
        "anyOf": [
          { "properties": { "activity_time_minutes": { "type": "number" } } },
          { "properties": { "activity_time_minutes": { "type": "null" } } }
        ]
      }
    }
  ]
}

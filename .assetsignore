# Files listed here are NOT uploaded to the public website by Cloudflare (Workers static assets).
# Same pattern rules as .gitignore. Paths are relative to the site root.
# This hides files from the live site only; it does not make anything private on GitHub.
# To make something public again, delete its line. To keep a new internal file private, add a line.

# Git and deployment internals
.git
.gitignore
.gitattributes
.assetsignore
.wrangler
.dev.vars*
.env*
wrangler.json
wrangler.jsonc
wrangler.toml
node_modules
package.json
package-lock.json

# Local tool and editor folders, OS clutter
.claude
.playwright-mcp
_mockups
desktop.ini
Thumbs.db
.DS_Store

# Private project notes and old zip archives
PROJECT_NOTES.md
*.zip

# Developer documentation and tests (the data files the site reads are NOT listed here)
data/*.md
data/*.test.js
data/resource.schema.json

# Build and thumbnail scripts, legacy tool templates (nothing public links to this folder)
tools

# Unfinished Stripe shop prototype: local only, never published. The repository has no .gitignore, so these
# lines are the safeguard if the prototype files are ever committed by mistake. Remove them only if a real shop is built.
/shop/
data/products.json

# Legacy archives, retired-system code and image masters. Nothing on the site links to or loads them (checked 2026-10-17:
# no page, script, data file or build step uses them), so they are not published. The local files are kept.
/_archived-activities/
/files3/
/files4/
data/dispatch-match.js
images/resources/_masters/
